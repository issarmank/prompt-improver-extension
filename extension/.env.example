# Copy to extension/.env.production for a release build. That file is
# gitignored; this one documents what it needs to contain.
#
# Everything here is inlined into the extension bundle at build time, so
# treat these values as public. Never put an API key in a VITE_ variable —
# the server holds the OpenRouter key (see server/.env.example).

# Backend that the service worker calls for the rewrite. Origin only, no
# trailing slash — vite.config.ts derives the manifest's host permission
# from it, and a path here would produce an invalid pattern.
# Falls back to http://localhost:8787 when unset, which is what dev builds use.
VITE_BACKEND_URL=https://your-backend-host
