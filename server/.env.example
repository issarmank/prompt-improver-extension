# Copy to server/.env — `npm start` loads it automatically. Never commit .env.

# Required: OpenRouter API key (https://openrouter.ai/keys) for the rewrite call.
OPENROUTER_API_KEY=sk-or-...

# Port the Express server listens on.
PORT=8787

# Redis connection used for the rate limiter.
REDIS_URL=redis://127.0.0.1:6379

# Set to true when the Redis server requires TLS (e.g. Azure Cache on :6380).
# A rediss:// URL enables TLS by itself; this flag covers redis:// URLs.
REDIS_TLS=false

# CORS allowlist: the extension's origin(s), comma-separated. Find the id at
# chrome://extensions with Developer mode on. Browser requests from any other
# origin are rejected; requests without an Origin header (curl) pass through.
EXTENSION_ORIGIN=chrome-extension://your-extension-id

# Per-install request budget for POST /rewrite.
RATE_LIMIT_POINTS=20
RATE_LIMIT_DURATION_SECONDS=3600

# Timeout for the OpenRouter call, in milliseconds.
LLM_TIMEOUT_MS=20000

# Caps the rewritten prompt's length so a runaway generation can't stall the request.
LLM_MAX_TOKENS=1024
